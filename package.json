{
  "name": "pstefanou12.github.io",
  "version": "1.0.0",
  "description": "Resume Website",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:delphi": "vite delphi/web",
    "build:delphi": "rm -rf delphi/assets && vite build delphi/web",
    "typecheck:delphi": "tsc -p delphi/web",
    "docs:api": "poetry -C ${DELPHI_AI:-$HOME/delphi.ai} run python \"$PWD/delphi/scripts/extract_api.py\" --out \"$PWD/delphi/web/src/generated/api.json\" ${DELPHI_REF:+--ref \"$DELPHI_REF\"}",
    "lint:delphi": "eslint delphi/web eslint.config.js .prettierrc.js",
    "fix:delphi": "eslint --fix delphi/web eslint.config.js .prettierrc.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pstefanou12/pstefanou12.github.io.git"
  },
  "keywords": [],
